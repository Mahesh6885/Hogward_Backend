APP_NAME=Project Portal
APP_ENV=production

# MySQL connection string (Standard on PythonAnywhere)
# Format: mysql+pymysql://username:password@username.mysql.pythonanywhere-services.com/username$dbname
DATABASE_URL=mysql+pymysql://YOUR_PA_USER:YOUR_DB_PASSWORD@YOUR_PA_USER.mysql.pythonanywhere-services.com/YOUR_PA_USER$project_portal

# (Alternative) External PostgreSQL (e.g., Neon / Supabase):
# DATABASE_URL=postgresql+psycopg://username:password@host/dbname?sslmode=require

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Update with your actual PythonAnywhere domain
CORS_ORIGINS=https://YOUR_PA_USER.pythonanywhere.com,http://localhost:5500,http://127.0.0.1:5500

MAX_REVIEW_ROUNDS=3

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_NAME=System Administrator
