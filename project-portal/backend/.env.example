APP_NAME=Project Portal
APP_ENV=production

# PostgreSQL connection string
# PythonAnywhere format: postgresql+psycopg://username:password@username.mysql.pythonanywhere-services.com/username$dbname
# Use your actual PythonAnywhere credentials below
DATABASE_URL=postgresql+psycopg://YOUR_PA_USER:YOUR_DB_PASSWORD@YOUR_PA_USER.postgres.pythonanywhere-services.com/YOUR_PA_USER$project_portal

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Update with your actual PythonAnywhere domain
CORS_ORIGINS=https://YOUR_PA_USER.pythonanywhere.com,http://localhost:5500,http://127.0.0.1:5500

MAX_REVIEW_ROUNDS=3

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_NAME=System Administrator
